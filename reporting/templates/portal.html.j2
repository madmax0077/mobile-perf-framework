{% extends "base.html.j2" %}
{% block page_title %}{{ title }} - all runs{% endblock %}
{% block nav %}
        {% if entries %}<li class="nav-item"><a class="nav-link" href="{{ entries[0].report }}">Latest run</a></li>{% endif %}
        <li class="nav-item"><a class="nav-link" href="#runs">Runs</a></li>
        <li class="nav-item"><a class="nav-link" href="#trends">Trends</a></li>
{% endblock %}
{% block content %}
  <section id="runs" class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="section-title mb-0">Test runs <span class="badge text-bg-secondary align-middle fs-6">{{ entries | length }}</span></h2>
      <input id="run-filter" class="form-control form-control-sm w-auto" type="search" placeholder="Filter (label, device, version...)">
    </div>
    {% if entries %}
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="run-table">
          <thead class="table-light"><tr>
            <th>Run</th><th>Started (UTC)</th><th>Label</th><th>App</th><th>Device / provider</th>
            <th>Tests</th><th>Crashes</th><th>Issues</th><th>Score</th><th>Readiness</th></tr></thead>
          <tbody>
          {% for r in entries %}
            <tr id="run-{{ r.run_id }}">
              <td class="fw-semibold"><a href="{{ r.report }}">{{ r.run_id }}</a>{% if loop.first %} <span class="badge text-bg-primary">latest</span>{% endif %}</td>
              <td class="small">{{ r.started_at.strftime('%Y-%m-%d %H:%M:%S') }}<div class="text-secondary">{{ '%.0f' % r.duration_sec }} s</div></td>
              <td>{{ r.label }}</td>
              <td class="small">{{ r.app_version }} ({{ r.build_number }})</td>
              <td class="small">{{ r.device or '-' }}<div class="text-secondary">{{ r.provider }}</div></td>
              <td class="small">
                {% for status, n in r.tests.items() %}<span class="badge text-bg-{{ {'passed': 'success', 'failed': 'danger', 'error': 'danger'}.get(status, 'secondary') }}">{{ n }} {{ status }}</span> {% endfor %}
              </td>
              <td>{% if r.crashes %}<a class="badge text-bg-danger text-decoration-none" href="{{ r.report }}#stability">{{ r.crashes }}</a>{% else %}0{% endif %}</td>
              <td class="small">
                {% for sev, n in r.issues.items() if n %}<a class="badge text-bg-{{ {'critical': 'danger', 'major': 'warning', 'minor': 'info'}[sev] }} text-decoration-none" href="{{ r.report }}#issues">{{ n }} {{ sev }}</a> {% else %}0{% endfor %}
              </td>
              <td>{{ '%.1f' % r.score if r.score is not none else '-' }}<div class="small text-secondary">{{ r.rating }}</div></td>
              <td><a class="badge text-bg-{{ readiness_class.get(r.readiness, 'secondary') }} text-decoration-none" href="{{ r.report }}#readiness">{{ r.readiness }}</a></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% else %}
    <div class="card"><div class="card-body text-secondary">No runs yet.</div></div>
    {% endif %}
  </section>

  <section id="trends" class="mb-5">
    <h2 class="section-title mb-3">Trend Report</h2>
    <div class="card"><div class="card-body">{{ trend_chart | safe }}</div></div>
  </section>
{% endblock %}
{% block footer %}Each run is kept in its own folder under <code>runs/</code>; <a href="latest.html">latest.html</a> always opens the newest run.{% endblock %}
{% block scripts %}
<script>
document.getElementById('run-filter').addEventListener('input', event => {
  const needle = event.target.value.toLowerCase();
  document.querySelectorAll('#run-table tbody tr').forEach(row => {
    row.style.display = row.textContent.toLowerCase().includes(needle) ? '' : 'none';
  });
});
</script>
{% endblock %}
