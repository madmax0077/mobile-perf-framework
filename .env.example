# Copy to .env and fill in. Never commit real credentials.

# Provider selection: simulated | local | testmu
PERF_PROVIDER=simulated
PERF_DEVICE=pixel_8
# Verify TLS with the OS certificate store (needed behind corporate TLS proxies)
PERF_SYSTEM_TRUST_STORE=true

# TestMu AI (formerly LambdaTest) credentials
TESTMU_USERNAME=
TESTMU_ACCESS_KEY=
# Application under test
APP_NAME=
APP_VERSION=1.0.0
APP_BUILD=localApp
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
# Local .apk/.ipa path, lt://APP... id, or an https URL
ANDROID_APP=
IOS_BUNDLE_ID=
IOS_APP=

# Build comparison (benchmark tests)
BUILD_A_APP=
BUILD_A_LABEL=build-a
BUILD_B_APP=
BUILD_B_LABEL=build-b

# Test account used by the user journey
APP_TEST_USER=
APP_TEST_PASSWORD=
# Phone / PIN / OTP login (tests/smoke/test_login.py)
APP_TEST_PHONE=
APP_TEST_PIN=
APP_TEST_OTP=
# A store the test account follows (tests/smoke/test_engagement.py::test_stores)
APP_TEST_STORE=L'Aura
# Fail tests in which the app crashed / hit an ANR (default true)
PERF_FAIL_ON_CRASH=true
# Fail tests that breach a production benchmark limit (default false: report only)
PERF_FAIL_ON_BENCHMARK=false
# Step screenshots: every_step | on_failure | off
PERF_SCREENSHOTS=every_step
# Run report folders kept under reports/runs (0 = keep all)
PERF_KEEP_RUNS=30
# Comma-separated Java/Kotlin packages of your own code (e.g. com.adw), so slow-step
# root causes name your class/method rather than a library frame (default: app package)
PERF_APP_PACKAGES=
# Comma-separated extra hosts that never block the UI (analytics, logging, ...)
PERF_BACKGROUND_HOSTS=

# Local provider
APPIUM_URL=http://127.0.0.1:4723
ANDROID_SERIAL=
IOS_UDID=
